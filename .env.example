# Local configuration for chora-notifications.
# Copy to .env and fill in values. Never commit .env or secrets.

CHORA_ENV=local
PORT=8080
CHORA_GRPC_PORT=9090

# Database (PostgreSQL). CHORA_DB_DSN is the runtime DSN (app_rw role).
# CHORA_OUTBOX_DSN defaults to the same database when omitted.
POSTGRES_DB=chora_notifications
POSTGRES_USER=chora
POSTGRES_PASSWORD=chora
POSTGRES_PORT=5432
CHORA_DB_DSN=postgres://chora:chora@localhost:5432/chora_notifications?sslmode=disable
CHORA_OUTBOX_DSN=postgres://chora:chora@localhost:5432/chora_notifications?sslmode=disable
CHORA_OUTBOX_WORKER_ID=chora-notifications-local

# Event bus — NATS JetStream. Unset disables the bus (in-memory fallback).
NATS_URL=nats://127.0.0.1:4222
CHORA_SOURCE_PROJECT=chora-local

# Email provider — "sendgrid" for real sends, unset/"stub" for dev stub mode.
# The SendGrid API key is resolved from the env-backed secret resolver.
EMAIL_PROVIDER=
SENDGRID_API_KEY=
MAIL_FROM=noreply@chora.site
MAIL_FROM_NAME=Chora

# Identity gRPC (gcid → email resolution for the email-send pipeline).
SVC_IDENTITY_GRPC_URL=

# Email-channel fan-out gate (default OFF — in_app only).
CHORA_EMAIL_FANOUT_ENABLED=

# Tracing — OTLP/gRPC endpoint (the OTel Collector). Unset falls back to stdout.
OTEL_EXPORTER_OTLP_ENDPOINT=

# Integration tests (build-tagged `integration`) — real PostgreSQL DSN.
# CHORA_TEST_DSN=postgres://chora:chora@localhost:5432/chora_notifications?sslmode=disable
