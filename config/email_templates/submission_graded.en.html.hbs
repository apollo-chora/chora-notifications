<!DOCTYPE html>
<html lang="en" xmlns="http://www.w3.org/1999/xhtml" xmlns:v="urn:schemas-microsoft-com:vml" xmlns:o="urn:schemas-microsoft-com:office:office">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <meta http-equiv="X-UA-Compatible" content="IE=edge">
  <meta name="color-scheme" content="light">
  <title>Your submission has been graded</title>
</head>
<body style="margin:0; padding:0; width:100%; background-color:#eef2f7; -webkit-font-smoothing:antialiased; font-family:'Inter',-apple-system,BlinkMacSystemFont,'Segoe UI',Roboto,Helvetica,Arial,sans-serif; color:#0f172a;">
  <div style="display:none; max-height:0; overflow:hidden; opacity:0; mso-hide:all;">Your submission &ldquo;{{submission_title}}&rdquo; scored {{score}} / {{max_score}}.</div>
  <table role="presentation" width="100%" cellpadding="0" cellspacing="0" border="0" style="background-color:#eef2f7;">
    <tr>
      <td align="center" style="padding:40px 16px;">
        <table role="presentation" width="600" cellpadding="0" cellspacing="0" border="0" style="max-width:600px; width:100%; background-color:#ffffff; border-radius:16px; overflow:hidden; box-shadow:0 6px 24px rgba(15,23,42,0.08); border:1px solid #e2e8f0;">
          <tr>
            <td style="background:#1976d2; background:linear-gradient(135deg,#1976d2 0%,#7c4dff 100%); padding:24px 32px;">
              <table role="presentation" width="100%" cellpadding="0" cellspacing="0" border="0"><tr>
                <td style="font-size:18px; font-weight:700; letter-spacing:0.4px; color:#ffffff;">Chora</td>
                <td align="right" style="font-size:12px; font-weight:500; letter-spacing:0.6px; color:rgba(255,255,255,0.78); text-transform:uppercase;">Assessment</td>
              </tr></table>
            </td>
          </tr>
          <tr><td style="height:4px; background:linear-gradient(90deg,#7B2D8E 0%,#C4107B 50%,#3b82f6 100%); font-size:0; line-height:0;">&nbsp;</td></tr>
          <tr>
            <td style="padding:40px 40px 8px 40px;">
              <h1 style="margin:0 0 14px 0; font-size:26px; line-height:1.25; font-weight:700; color:#0f172a;">Your work has been graded</h1>
              <p style="margin:0 0 24px 0; font-size:16px; line-height:1.65; color:#475569;">
                Hi {{learner_name}}, your submission <strong style="color:#0f172a;">{{submission_title}}</strong> for {{course_title}} has been reviewed.
              </p>
            </td>
          </tr>
          <tr>
            <td style="padding:0 40px 28px 40px;">
              <table role="presentation" width="100%" cellpadding="0" cellspacing="0" border="0" style="background-color:#f8fafc; border:1px solid #e2e8f0; border-radius:12px;">
                <tr>
                  <td align="center" style="padding:24px;">
                    <div style="font-size:12px; text-transform:uppercase; letter-spacing:1.2px; color:#94a3b8; margin-bottom:8px;">Score</div>
                    <div style="font-size:38px; font-weight:800; line-height:1; color:#1976d2;">{{score}} <span style="font-size:22px; font-weight:600; color:#94a3b8;">/ {{max_score}}</span></div>
                  </td>
                </tr>
              </table>
            </td>
          </tr>
          <tr>
            <td style="padding:0 40px 36px 40px;">
              <table role="presentation" cellpadding="0" cellspacing="0" border="0"><tr>
                <td align="center" bgcolor="#1976d2" style="border-radius:10px;">
                  <a href="{{feedback_url}}" target="_blank" style="display:inline-block; padding:14px 34px; font-size:16px; font-weight:600; color:#ffffff; text-decoration:none; border-radius:10px; background:#1976d2;">View full feedback &rarr;</a>
                </td>
              </tr></table>
            </td>
          </tr>
          <tr>
            <td style="background-color:#f8fafc; padding:22px 40px; border-top:1px solid #e2e8f0;">
              <p style="margin:0; font-size:12px; line-height:1.6; color:#94a3b8;">
                You&rsquo;re receiving this because you submitted an assessment on Chora. Manage email preferences in your account notification settings.
              </p>
            </td>
          </tr>
        </table>
        <table role="presentation" width="600" cellpadding="0" cellspacing="0" border="0" style="max-width:600px; width:100%;"><tr>
          <td align="center" style="padding:18px 0 0 0; font-size:11px; color:#b0bac9;">Chora &middot; Bimodal Atomic Learning</td>
        </tr></table>
      </td>
    </tr>
  </table>
</body>
</html>
