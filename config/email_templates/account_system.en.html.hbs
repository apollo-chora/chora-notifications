<!DOCTYPE html>
<html lang="en" xmlns="http://www.w3.org/1999/xhtml" xmlns:v="urn:schemas-microsoft-com:vml" xmlns:o="urn:schemas-microsoft-com:office:office">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <meta http-equiv="X-UA-Compatible" content="IE=edge">
  <meta name="color-scheme" content="light">
  <title>An update about your account</title>
</head>
<body style="margin:0; padding:0; width:100%; background-color:#eef2f7; -webkit-font-smoothing:antialiased; font-family:'Inter',-apple-system,BlinkMacSystemFont,'Segoe UI',Roboto,Helvetica,Arial,sans-serif; color:#0f172a;">
  <div style="display:none; max-height:0; overflow:hidden; opacity:0; mso-hide:all;">{{message}}</div>
  <table role="presentation" width="100%" cellpadding="0" cellspacing="0" border="0" style="background-color:#eef2f7;">
    <tr>
      <td align="center" style="padding:40px 16px;">
        <table role="presentation" width="600" cellpadding="0" cellspacing="0" border="0" style="max-width:600px; width:100%; background-color:#ffffff; border-radius:16px; overflow:hidden; box-shadow:0 6px 24px rgba(15,23,42,0.08); border:1px solid #e2e8f0;">
          <tr>
            <td style="background:#1976d2; background:linear-gradient(135deg,#1976d2 0%,#7c4dff 100%); padding:24px 32px;">
              <table role="presentation" width="100%" cellpadding="0" cellspacing="0" border="0"><tr>
                <td style="font-size:18px; font-weight:700; letter-spacing:0.4px; color:#ffffff;">Chora</td>
                <td align="right" style="font-size:12px; font-weight:500; letter-spacing:0.6px; color:rgba(255,255,255,0.78); text-transform:uppercase;">Account</td>
              </tr></table>
            </td>
          </tr>
          <tr><td style="height:4px; background:linear-gradient(90deg,#7B2D8E 0%,#C4107B 50%,#3b82f6 100%); font-size:0; line-height:0;">&nbsp;</td></tr>
          <tr>
            <td style="padding:40px 40px 8px 40px;">
              <h1 style="margin:0 0 14px 0; font-size:24px; line-height:1.25; font-weight:700; color:#0f172a;">Account update</h1>
              <p style="margin:0 0 16px 0; font-size:16px; line-height:1.65; color:#475569;">Hi {{learner_name}},</p>
              <p style="margin:0 0 24px 0; font-size:16px; line-height:1.65; color:#475569;">{{message}}</p>
            </td>
          </tr>
          <tr>
            <td style="padding:0 40px 36px 40px;">
              <table role="presentation" cellpadding="0" cellspacing="0" border="0"><tr>
                <td align="center" bgcolor="#1976d2" style="border-radius:10px;">
                  <a href="{{action_url}}" target="_blank" style="display:inline-block; padding:14px 34px; font-size:16px; font-weight:600; color:#ffffff; text-decoration:none; border-radius:10px; background:#1976d2;">Go to your account &rarr;</a>
                </td>
              </tr></table>
            </td>
          </tr>
          <tr>
            <td style="padding:0 40px 36px 40px;">
              <div style="border-top:1px solid #f1f5f9; padding-top:24px;">
                <p style="margin:0; font-size:14px; line-height:1.6; color:#64748b;">
                  If you did not expect this email, please contact your administrator.<br>
                  <strong style="color:#0f172a;">The {{tenant_name}} team</strong>
                </p>
              </div>
            </td>
          </tr>
          <tr>
            <td style="background-color:#f8fafc; padding:22px 40px; border-top:1px solid #e2e8f0;">
              <p style="margin:0; font-size:12px; line-height:1.6; color:#94a3b8;">
                This is an account &amp; system notification from Chora. Manage email preferences in your account notification settings.
              </p>
            </td>
          </tr>
        </table>
        <table role="presentation" width="600" cellpadding="0" cellspacing="0" border="0" style="max-width:600px; width:100%;"><tr>
          <td align="center" style="padding:18px 0 0 0; font-size:11px; color:#b0bac9;">Chora &middot; Bimodal Atomic Learning</td>
        </tr></table>
      </td>
    </tr>
  </table>
</body>
</html>
